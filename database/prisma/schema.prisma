enum HrApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HrApprovalNotificationSubject {
  APPROVAL
  TRANSFER
}

enum HrApprovalNotificationPurpose {
  PENDING
  CORRECTION
}

enum HrApprovalNotificationStatus {
  QUEUED
  SENT
  FAILED
}

// Outbox entries are created in the same transaction as workflow changes.
// They retain only the notification label and applicant name required by the
// WeChat template, never the underlying HR form data.
model HrApprovalNotification {
  id              BigInt                        @id @default(autoincrement())
  subject         HrApprovalNotificationSubject
  subjectId       BigInt                        @map("subject_id")
  stageKey        String                        @map("stage_key") @db.VarChar(30)
  purpose         HrApprovalNotificationPurpose
  recipientUserId BigInt                        @map("recipient_user_id")
  formName        String                        @map("form_name") @db.VarChar(80)
  applicantName   String                        @map("applicant_name") @db.VarChar(80)
  page            String                        @db.VarChar(150)
  status          HrApprovalNotificationStatus  @default(QUEUED)
  reasonCode      String?                       @map("reason_code") @db.VarChar(80)
  attempts        Int                           @default(0)
  lastAttemptAt   DateTime?                     @map("last_attempt_at")
  sentAt          DateTime?                     @map("sent_at")
  createdAt       DateTime                      @default(now()) @map("created_at")

  @@unique([subject, subjectId, stageKey, purpose, recipientUserId], map: "hr_appr_notify_subject_stage_recipient_uq")
  @@index([status, createdAt], map: "hr_appr_notify_status_created_idx")
  @@index([recipientUserId, status, createdAt], map: "hr_appr_notify_recipient_status_created_idx")
  @@map("hr_approval_notifications")
}

model HrPermission {
