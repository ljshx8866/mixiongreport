generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Region {
  id     BigInt  @id @default(autoincrement())
  name   String  @db.VarChar(100)
  stores Store[]

  // Region remains operating-system reporting metadata; account store access is defined by UserStore.
  @@map("regions")
}

model Store {
  id                       BigInt                    @id @default(autoincrement())
  storeCode                String                    @unique @map("store_code") @db.VarChar(50)
  storeName                String                    @map("store_name") @db.VarChar(100)
  brandName                String                    @default("米熊") @map("brand_name") @db.VarChar(100)
  regionId                 BigInt?                   @map("region_id")
  region                   Region?                   @relation(fields: [regionId], references: [id])
  externalStoreCode        String?                   @unique @map("external_store_code") @db.VarChar(100)
  status                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  users                    UserStore[]
  sales                    DailySale[]
  periods                  SalesPeriod[]
  groupBuy                 GroupBuySale[]
  products                 ProductDailySale[]
  inputs                   StoreDailyInput[]
  reportStates             DailyReportState[]
  syncLogs                 ApiSyncLog[]
  hrPrimaryAppointments    HrPrimaryAppointment[]
  hrInitialEmployees       HrEmployee[]              @relation("HrEmployeeInitialStore")
  hrJobPositionStores      HrJobPositionStore[]
  hrOnboardingIntakeDrafts HrOnboardingIntakeDraft[]
  hrOnboardingRequests     HrOnboardingRequest[]
  hrBankChangeRequests     HrBankChangeRequest[]
  hrOffboardingRequests    HrOffboardingRequest[]
  hrSalaryChanges          HrSalaryChangeRequest[]
  hrSchedules              HrSchedule[]
  hrShiftTemplates         HrShiftTemplate[]
  hrSchedulePoints         HrSchedulePoint[]
  hrWorkRecords            HrWorkRecord[]
  hrMonthlyReviews         HrMonthlyReview[]
  hrTransfersOut           HrTransferRequest[]       @relation("HrTransferSourceStore")
  hrTransfersIn            HrTransferRequest[]       @relation("HrTransferDestinationStore")

  @@map("stores")
}

model User {
  id                       BigInt                     @id @default(autoincrement())
  name                     String                     @db.VarChar(100)
  mobile                   String?                    @unique @db.VarChar(30)
  openid                   String?                    @unique @db.VarChar(100)
  passwordHash             String?                    @map("password_hash") @db.VarChar(255)
  role                     UserRole
  localRoleOverride        Boolean                    @default(false) @map("local_role_override")
  homeFavoriteModules      Json?                      @map("home_favorite_modules")
  notificationPreferences  Json?                      @map("notification_preferences")
  status                   Boolean                    @default(true)
  source                   UserSource                 @default(LOCAL)
  externalUserId           String?                    @unique @map("external_user_id") @db.VarChar(100)
  externalUserCode         String?                    @unique @map("external_user_code") @db.VarChar(100)
  externalDutyName         String?                    @map("external_duty_name") @db.VarChar(100)
  lastSyncedAt             DateTime?                  @map("last_synced_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  stores                   UserStore[]
  inputs                   StoreDailyInput[]
  audits                   AuditLog[]
  hrEmployee               HrEmployee?
  hrRoleGrants             HrRoleGrant[]
  hrSensitiveDrafts        HrSensitiveDraftRevision[]
  hrOnboardingIntakeDrafts HrOnboardingIntakeDraft[]
  notifications            UserNotification[]

  @@map("users")
}

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// Account-scoped in-app inbox. These durable records are separate from the
// WeChat template-message outbox and carry their own read state.
model UserNotification {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  category  String    @db.VarChar(30)
  title     String    @db.VarChar(120)
  summary   String    @db.VarChar(300)
  page      String    @db.VarChar(200)
  eventKey  String    @map("event_key") @db.VarChar(191)
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey], map: "user_notifications_user_event_uq")
  @@index([userId, readAt, createdAt], map: "user_notifications_user_read_created_idx")
  @@map("user_notifications")
}

// HR employee identity is separate from the POS-synchronised login account.
// A draft cannot receive active assignments or confirmed work by itself.
model HrEmployee {
  id                  BigInt                     @id @default(autoincrement())
  displayName         String                     @map("display_name") @db.VarChar(100)
  status              HrEmployeeStatus           @default(DRAFT)
  initialStoreId      BigInt?                    @map("initial_store_id")
  trialStartedAt      DateTime?                  @map("trial_started_at") @db.Date
  trialEndedAt        DateTime?                  @map("trial_ended_at")
  jobPositionId       BigInt?                    @map("job_position_id")
  userId              BigInt?                    @unique @map("user_id")
  user                User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  initialStore        Store?                     @relation("HrEmployeeInitialStore", fields: [initialStoreId], references: [id])
  jobPosition         HrJobPosition?             @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  primaryAppointments HrPrimaryAppointment[]
  transfers           HrTransferRequest[]
  schedules           HrSchedule[]
  workRecords         HrWorkRecord[]
  sensitiveDrafts     HrSensitiveDraftRevision[]
  bankAccountVersions HrBankAccountVersion[]
  identityClaim       HrIdentityClaim?
  onboardingRequests  HrOnboardingRequest[]
  bankChangeRequests  HrBankChangeRequest[]
  offboardingRequests HrOffboardingRequest[]
  salaryRates         HrSalaryRate[]
  salaryChanges       HrSalaryChangeRequest[]

  @@index([initialStoreId, status])
  @@index([jobPositionId])
  @@map("hr_employees")
}

// A position is reusable across stores; store-specific hourly rates are kept in
// the association so stores can share job titles without duplicate positions.
model HrJobPosition {
  id                 BigInt                @id @default(autoincrement())
  name               String                @db.VarChar(100)
  scheduleOnly       Boolean               @default(false) @map("schedule_only")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  stores             HrJobPositionStore[]
  onboardingRequests HrOnboardingRequest[]
  employees          HrEmployee[]

  @@unique([name])
  @@map("hr_job_positions")
}

model HrJobPositionStore {
  jobPositionId BigInt        @map("job_position_id")
  storeId       BigInt        @map("store_id")
  hourlyRate    Decimal?      @map("hourly_rate") @db.Decimal(12, 2)
  enabled       Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  jobPosition   HrJobPosition @relation(fields: [jobPositionId], references: [id], onDelete: Cascade)
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@id([jobPositionId, storeId])
  @@index([storeId, enabled])
  @@map("hr_job_position_stores")
}

// A temporary pre-submission form is encrypted and scoped to the submitting user and store.
model HrOnboardingIntakeDraft {
  id            BigInt   @id @default(autoincrement())
  actorId       BigInt   @map("actor_id")
  storeId       BigInt   @map("store_id")
  sealedPayload Json     @map("sealed_payload")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([actorId, storeId])
  @@index([expiresAt])
  @@index([storeId])
  @@map("hr_onboarding_intake_drafts")
}

enum HrSensitiveDraftKind {
  IDENTITY
  BANK
}

// Append-only encrypted structured drafts. Images are never stored here.
model HrSensitiveDraftRevision {
  id                 BigInt                @id @default(autoincrement())
  employeeId         BigInt                @map("employee_id")
  kind               HrSensitiveDraftKind
  version            Int
  sealedPayload      Json                  @map("sealed_payload")
  maskedValue        String                @map("masked_value") @db.VarChar(32)
  source             String                @db.VarChar(30)
  providerRef        String?               @map("provider_ref") @db.VarChar(100)
  createdBy          BigInt?               @map("created_by")
  createdAt          DateTime              @default(now()) @map("created_at")
  employee           HrEmployee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  actor              User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  bankAccountVersion HrBankAccountVersion?
  bankChangeRequests HrBankChangeRequest[]

  @@unique([employeeId, kind, version])
  @@index([employeeId, kind, createdAt])
  @@map("hr_sensitive_draft_revisions")
}

// Only one current employee may claim an identity number. The HMAC key is separate from encryption keys.
model HrIdentityClaim {
  employeeId  BigInt     @id @map("employee_id")
  fingerprint String     @unique @db.Char(64)
  version     Int
  updatedAt   DateTime   @updatedAt @map("updated_at")
  employee    HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("hr_identity_claims")
}

enum HrEmployeeStatus {
  DRAFT
  TRIAL
  TRIAL_ENDED
  ACTIVE
  TERMINATED
}

model HrSchedule {
  id              BigInt               @id @default(autoincrement())
  employeeId      BigInt               @map("employee_id")
  storeId         BigInt               @map("store_id")
  shiftTemplateId BigInt?              @map("shift_template_id")
  pointId         BigInt?              @map("point_id")
  pointName       String?              @map("point_name") @db.VarChar(80)
  businessDate    DateTime             @map("business_date") @db.Date
  status          HrScheduleStatus     @default(DRAFT)
  currentVersion  Int                  @default(1) @map("current_version")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  employee        HrEmployee           @relation(fields: [employeeId], references: [id])
  store           Store                @relation(fields: [storeId], references: [id])
  shiftTemplate   HrShiftTemplate?     @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)
  point           HrSchedulePoint?     @relation(fields: [pointId], references: [id], onDelete: SetNull)
  versions        HrScheduleVersion[]
  deliveries      HrScheduleDelivery[]
  workRecord      HrWorkRecord?

  @@index([storeId, businessDate, status])
  @@index([employeeId, businessDate])
  @@index([shiftTemplateId])
  @@index([pointId])
  @@map("hr_schedules")
}

// Reusable, store-specific shift definitions. Schedule versions retain their
// exact planned timestamps so later template edits never rewrite history.
model HrShiftTemplate {
  id           BigInt       @id @default(autoincrement())
  storeId      BigInt       @map("store_id")
  code         String       @db.VarChar(30)
  name         String       @db.VarChar(80)
  startTime    String       @map("start_time") @db.VarChar(5)
  endTime      String       @map("end_time") @db.VarChar(5)
  breakMinutes Int          @default(0) @map("break_minutes")
  sortOrder    Int          @default(0) @map("sort_order")
  enabled      Boolean      @default(true)
  createdBy    BigInt       @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  schedules    HrSchedule[]

  @@unique([storeId, code])
  @@index([storeId, enabled, sortOrder])
  @@map("hr_shift_templates")
}

// Store-specific work locations shown beside each employee in schedule summaries.
// The name snapshot on HrSchedule keeps historical posters readable after edits/deletion.
model HrSchedulePoint {
  id        BigInt       @id @default(autoincrement())
  storeId   BigInt       @map("store_id")
  name      String       @db.VarChar(80)
  sortOrder Int          @default(0) @map("sort_order")
  enabled   Boolean      @default(true)
  createdBy BigInt       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  schedules HrSchedule[]

  @@unique([storeId, name])
  @@index([storeId, enabled, sortOrder])
  @@map("hr_schedule_points")
}

model HrScheduleVersion {
  scheduleId   BigInt              @map("schedule_id")
  version      Int
  plannedStart DateTime            @map("planned_start")
  plannedEnd   DateTime            @map("planned_end")
  breakMinutes Int                 @map("break_minutes")
  createdBy    BigInt              @map("created_by")
  createdAt    DateTime            @default(now()) @map("created_at")
  publishedAt  DateTime?           @map("published_at")
  schedule     HrSchedule          @relation(fields: [scheduleId], references: [id])
  delivery     HrScheduleDelivery?

  @@id([scheduleId, version])
  @@map("hr_schedule_versions")
}

model HrScheduleDelivery {
  id                BigInt                   @id @default(autoincrement())
  scheduleId        BigInt                   @map("schedule_id")
  version           Int
  status            HrScheduleDeliveryStatus @default(UNAVAILABLE)
  reasonCode        String?                  @map("reason_code") @db.VarChar(80)
  attempts          Int                      @default(0)
  providerMessageId String?                  @map("provider_message_id") @db.VarChar(150)
  lastAttemptAt     DateTime?                @map("last_attempt_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  schedule          HrSchedule               @relation(fields: [scheduleId], references: [id])
  scheduleVersion   HrScheduleVersion        @relation(fields: [scheduleId, version], references: [scheduleId, version])

  @@unique([scheduleId, version])
  @@index([status, createdAt])
  @@map("hr_schedule_deliveries")
}

enum HrScheduleStatus {
  DRAFT
  PUBLISHED
  CANCELED
}

enum HrScheduleDeliveryStatus {
  UNAVAILABLE
  QUEUED
  SENT
  FAILED
}

// Confirmed evidence is immutable by version. The record points at its current
// version; natural-day segments are recalculated from exact timestamps/breaks.
model HrWorkRecord {
  id             BigInt                @id @default(autoincrement())
  scheduleId     BigInt                @unique @map("schedule_id")
  employeeId     BigInt                @map("employee_id")
  storeId        BigInt                @map("store_id")
  currentVersion Int                   @default(1) @map("current_version")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  schedule       HrSchedule            @relation(fields: [scheduleId], references: [id])
  employee       HrEmployee            @relation(fields: [employeeId], references: [id])
  store          Store                 @relation(fields: [storeId], references: [id])
  versions       HrWorkRecordVersion[]
  corrections    HrTimeCorrection[]

  @@index([employeeId, storeId])
  @@map("hr_work_records")
}

model HrWorkRecordVersion {
  recordId    BigInt             @map("record_id")
  version     Int
  actualStart DateTime           @map("actual_start")
  actualEnd   DateTime           @map("actual_end")
  breaks      Json
  rawMinutes  Int                @map("raw_minutes")
  confirmedBy BigInt             @map("confirmed_by")
  reason      String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")
  record      HrWorkRecord       @relation(fields: [recordId], references: [id])
  daySegments HrWorkDaySegment[]

  @@id([recordId, version])
  @@map("hr_work_record_versions")
}

model HrWorkDaySegment {
  recordId       BigInt              @map("record_id")
  version        Int
  businessDate   DateTime            @map("business_date") @db.Date
  elapsedMinutes Int                 @map("elapsed_minutes")
  breakMinutes   Int                 @map("break_minutes")
  rawMinutes     Int                 @map("raw_minutes")
  workVersion    HrWorkRecordVersion @relation(fields: [recordId, version], references: [recordId, version])

  @@id([recordId, version, businessDate])
  @@index([businessDate])
  @@map("hr_work_day_segments")
}

model HrTimeCorrection {
  id                 BigInt                 @id @default(autoincrement())
  recordId           BigInt                 @map("record_id")
  expectedVersion    Int                    @map("expected_version")
  proposedStart      DateTime               @map("proposed_start")
  proposedEnd        DateTime               @map("proposed_end")
  proposedBreaks     Json                   @map("proposed_breaks")
  proposedSegments   Json                   @map("proposed_segments")
  proposedRawMinutes Int                    @map("proposed_raw_minutes")
  reason             String                 @db.Text
  requestedBy        BigInt                 @map("requested_by")
  status             HrTimeCorrectionStatus @default(PENDING)
  failureCode        String?                @map("failure_code") @db.VarChar(80)
  createdAt          DateTime               @default(now()) @map("created_at")
  appliedAt          DateTime?              @map("applied_at")
  record             HrWorkRecord           @relation(fields: [recordId], references: [id])

  @@index([recordId, status])
  @@map("hr_time_corrections")
}

enum HrTimeCorrectionStatus {
  PENDING
  REJECTED
  APPLIED
  APPLY_FAILED
}

model HrMonthlyReview {
  id                 BigInt                @id @default(autoincrement())
  storeId            BigInt                @map("store_id")
  month              DateTime              @db.Date
  revision           Int
  status             HrMonthlyReviewStatus @default(SUBMITTED)
  snapshot           Json
  snapshotHash       String                @map("snapshot_hash") @db.VarChar(64)
  submittedBy        BigInt                @map("submitted_by")
  submittedAt        DateTime              @default(now()) @map("submitted_at")
  approvedAt         DateTime?             @map("approved_at")
  invalidatedAt      DateTime?             @map("invalidated_at")
  invalidationReason String?               @map("invalidation_reason") @db.VarChar(150)
  store              Store                 @relation(fields: [storeId], references: [id])

  @@unique([storeId, month, revision])
  @@index([storeId, month, status])
  @@map("hr_monthly_reviews")
}

enum HrMonthlyReviewStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

// [effectiveFrom, effectiveToExclusive); overlap checks must run in a
// transaction locking the employee row before an appointment is written.
model HrPrimaryAppointment {
  id                   BigInt     @id @default(autoincrement())
  employeeId           BigInt     @map("employee_id")
  storeId              BigInt     @map("store_id")
  effectiveFrom        DateTime   @map("effective_from") @db.Date
  effectiveToExclusive DateTime?  @map("effective_to_exclusive") @db.Date
  createdAt            DateTime   @default(now()) @map("created_at")
  employee             HrEmployee @relation(fields: [employeeId], references: [id])
  store                Store      @relation(fields: [storeId], references: [id])

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveToExclusive])
  @@index([storeId, effectiveFrom])
  @@map("hr_primary_appointments")
}

model HrRole {
  id                   BigInt                   @id @default(autoincrement())
  code                 String                   @unique @db.VarChar(50)
  name                 String                   @db.VarChar(100)
  enabled              Boolean                  @default(true)
  onboardingAssignable Boolean                  @default(false) @map("onboarding_assignable")
  participatesInScheduling Boolean              @default(true) @map("participates_in_scheduling")
  showStoreSwitcher    Boolean                  @default(false) @map("show_store_switcher")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  permissions          HrRolePermission[]
  grants               HrRoleGrant[]
  workflowSteps        HrApprovalWorkflowStep[]
  approvalSteps        HrApprovalInstanceStep[]
  onboardingRequests   HrOnboardingRequest[]

  @@map("hr_roles")
}

// Workflow edits affect only future requests. Each instance copies the role
// assigned to every step when it is opened.
model HrApprovalWorkflow {
  kind      HrApprovalKind           @id
  version   Int                      @default(0)
  updatedAt DateTime                 @updatedAt @map("updated_at")
  steps     HrApprovalWorkflowStep[]
  instances HrApprovalInstance[]

  @@map("hr_approval_workflows")
}

model HrApprovalWorkflowStep {
  kind     HrApprovalKind
  position Int
  roleId   BigInt             @map("role_id")
  workflow HrApprovalWorkflow @relation(fields: [kind], references: [kind])
  role     HrRole             @relation(fields: [roleId], references: [id])

  @@id([kind, position])
  @@map("hr_approval_workflow_steps")
}

model HrApprovalInstance {
  id              BigInt                   @id @default(autoincrement())
  kind            HrApprovalKind
  subjectId       BigInt                   @map("subject_id")
  scopeStoreId    BigInt                   @map("scope_store_id")
  requestedBy     BigInt                   @map("requested_by")
  workflowVersion Int                      @map("workflow_version")
  status          HrApprovalStatus         @default(PENDING)
  currentPosition Int?                     @default(1) @map("current_position")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  workflow        HrApprovalWorkflow       @relation(fields: [kind], references: [kind])
  steps           HrApprovalInstanceStep[]

  @@unique([kind, subjectId])
  @@index([scopeStoreId, status])
  @@map("hr_approval_instances")
}

model HrApprovalInstanceStep {
  instanceId BigInt                  @map("instance_id")
  position   Int
  roleId     BigInt                  @map("role_id")
  decision   HrTransferDecisionType?
  actorId    BigInt?                 @map("actor_id")
  reason     String?                 @db.Text
  decidedAt  DateTime?               @map("decided_at")
  instance   HrApprovalInstance      @relation(fields: [instanceId], references: [id])
  role       HrRole                  @relation(fields: [roleId], references: [id])

  @@id([instanceId, position])
  @@map("hr_approval_instance_steps")
}

enum HrApprovalKind {
  TIME_CORRECTION
  SALARY_CHANGE
  MONTHLY_REVIEW
  ONBOARDING
  OFFBOARDING
  BANK_CHANGE
}

enum HrOffboardingStatus {
  SUBMITTED
  APPROVED_AWAITING_EFFECTIVE
  REJECTED
  EFFECTIVE
  EFFECTIVE_FAILED
}

enum HrSalaryChangeStatus {
  SUBMITTED
  APPROVED_AWAITING_EFFECTIVE
  REJECTED
  EFFECTIVE
  EFFECTIVE_FAILED
}

model HrSalaryRate {
  id                        BigInt               @id @default(autoincrement())
  employeeId                BigInt               @map("employee_id")
  hourlyRate                Decimal              @map("hourly_rate") @db.Decimal(12, 2)
  effectiveFrom             DateTime             @map("effective_from") @db.Date
  effectiveToExclusive      DateTime?            @map("effective_to_exclusive") @db.Date
  sourceChangeId            BigInt?              @unique @map("source_change_id")
  sourceOnboardingRequestId BigInt?              @unique @map("source_onboarding_request_id")
  createdAt                 DateTime             @default(now()) @map("created_at")
  employee                  HrEmployee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sourceOnboardingRequest   HrOnboardingRequest? @relation(fields: [sourceOnboardingRequestId], references: [id], onDelete: Restrict)

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveToExclusive])
  @@map("hr_salary_rates")
}

model HrSalaryChangeRequest {
  id                 BigInt               @id @default(autoincrement())
  employeeId         BigInt               @map("employee_id")
  storeId            BigInt               @map("store_id")
  revision           Int
  expectedRateId     BigInt?              @map("expected_rate_id")
  proposedRate       Decimal              @map("proposed_rate") @db.Decimal(12, 2)
  effectiveDate      DateTime             @map("effective_date") @db.Date
  reason             String               @db.Text
  agreementReference String?              @map("agreement_reference") @db.VarChar(200)
  requestedBy        BigInt               @map("requested_by")
  status             HrSalaryChangeStatus @default(SUBMITTED)
  appliedAt          DateTime?            @map("applied_at")
  failureCode        String?              @map("failure_code") @db.VarChar(50)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  employee           HrEmployee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  store              Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, revision])
  @@index([status, effectiveDate])
  @@map("hr_salary_change_requests")
}

model HrOffboardingRequest {
  id                       BigInt              @id @default(autoincrement())
  employeeId               BigInt              @map("employee_id")
  storeId                  BigInt              @map("store_id")
  revision                 Int
  effectiveDate            DateTime            @map("effective_date") @db.Date
  reason                   String              @db.Text
  deleteAccountOnEffective Boolean             @default(true) @map("delete_account_on_effective")
  requestedBy              BigInt              @map("requested_by")
