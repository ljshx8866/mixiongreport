}

// HR grants define account capabilities only. Store access is governed once by
// UserStore and is shared with the operating system.
model HrRoleGrant {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  roleId    BigInt   @map("role_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      HrRole   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId, active])
  @@map("hr_role_grants")
}

model HrTransferRequest {
  id                     BigInt               @id @default(autoincrement())
  employeeId             BigInt               @map("employee_id")
