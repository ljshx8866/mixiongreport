generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Region {
  id     BigInt  @id @default(autoincrement())
  name   String  @db.VarChar(100)
  stores Store[]
  @@map("regions")
}

model Store {
  id                BigInt             @id @default(autoincrement())
  storeCode         String             @unique @map("store_code") @db.VarChar(50)
  storeName         String             @map("store_name") @db.VarChar(100)
  brandName         String             @default("米熊") @map("brand_name") @db.VarChar(100)
  regionId          BigInt?            @map("region_id")
  region            Region?            @relation(fields: [regionId], references: [id])
  externalStoreCode String?            @unique @map("external_store_code") @db.VarChar(100)
  status            Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  users             UserStore[]
  sales             DailySale[]
  periods           SalesPeriod[]
  groupBuy          GroupBuySale[]
  products          ProductDailySale[]
  inputs            StoreDailyInput[]
  reportStates      DailyReportState[]
  syncLogs          ApiSyncLog[]
  @@map("stores")
}

model User {
  id        BigInt      @id @default(autoincrement())
  name      String      @db.VarChar(100)
  mobile    String?     @unique @db.VarChar(30)
  openid    String?     @unique @db.VarChar(100)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  role      UserRole
  status    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  stores    UserStore[]
  inputs    StoreDailyInput[]
  audits    AuditLog[]
  @@map("users")
}

enum UserRole {
  ADMIN
  REGION_MANAGER
  STORE_MANAGER
}

model UserStore {
  id      BigInt @id @default(autoincrement())
  userId  BigInt @map("user_id")
  storeId BigInt @map("store_id")
  user    User   @relation(fields: [userId], references: [id])
  store   Store  @relation(fields: [storeId], references: [id])
  @@unique([userId, storeId])
  @@map("user_stores")
}

model ProductCategory {
  id           BigInt             @id @default(autoincrement())
  brandCode    String?            @map("brand_code") @db.VarChar(50)
  categoryCode String             @map("category_code") @db.VarChar(50)
  categoryName String             @map("category_name") @db.VarChar(100)
  sortOrder    Int                @default(0) @map("sort_order")
  status       Boolean            @default(true)
  products     Product[]
  dailySales   ProductDailySale[]
  @@unique([brandCode, categoryCode])
  @@map("product_categories")
}

model Product {
  id                  BigInt             @id @default(autoincrement())
  externalProductCode String             @unique @map("external_product_code") @db.VarChar(100)
  productName         String             @map("product_name") @db.VarChar(200)
  categoryId          BigInt             @map("category_id")
  category            ProductCategory    @relation(fields: [categoryId], references: [id])
  salePrice           Decimal?           @map("sale_price") @db.Decimal(12, 2)
  theoreticalCost     Decimal?           @map("theoretical_cost") @db.Decimal(12, 2)
  status              Boolean            @default(true)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  dailySales          ProductDailySale[]
  @@map("products")
}

model BusinessPeriod {
  id         BigInt   @id @default(autoincrement())
  periodCode String   @unique @map("period_code") @db.VarChar(30)
  periodName String   @map("period_name") @db.VarChar(50)
  startTime  String   @map("start_time") @db.Char(5)
  endTime    String   @map("end_time") @db.Char(5)
  externalShiftId String? @unique @map("external_shift_id") @db.VarChar(100)
  sortOrder  Int      @default(0) @map("sort_order")
  status     Boolean  @default(true)
  @@map("business_periods")
}

model PowerCalculationConfig {
  id        BigInt   @id @default(autoincrement())
  storeId   BigInt?  @unique @map("store_id")
  mode      PowerMode @default(SUM_COMPONENTS)
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("power_calculation_configs")
}

enum PowerMode {
  SUM_COMPONENTS
  MANUAL_TOTAL
}

model DailySale {
  id                  BigInt   @id @default(autoincrement())
  storeId             BigInt   @map("store_id")
  businessDate        DateTime @map("business_date") @db.Date
  totalSales          Decimal  @map("total_sales") @db.Decimal(12, 2)
  totalCustomerCount  Int      @map("total_customer_count")
  dineInSales         Decimal  @map("dine_in_sales") @db.Decimal(12, 2)
  dineInCustomerCount Int      @map("dine_in_customer_count")
  deliverySales       Decimal  @map("delivery_sales") @db.Decimal(12, 2)
  deliveryOrderCount  Int      @map("delivery_order_count")
  finalized           Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  store               Store    @relation(fields: [storeId], references: [id])
  @@unique([storeId, businessDate])
  @@map("daily_sales")
}

model SalesPeriod {
  id            BigInt   @id @default(autoincrement())
  storeId       BigInt   @map("store_id")
  businessDate  DateTime @map("business_date") @db.Date
  periodCode    String   @map("period_code") @db.VarChar(30)
  periodName    String   @map("period_name") @db.VarChar(50)
  salesAmount   Decimal  @map("sales_amount") @db.Decimal(12, 2)
  customerCount Int      @map("customer_count")
  store         Store    @relation(fields: [storeId], references: [id])
  @@unique([storeId, businessDate, periodCode])
  @@map("sales_periods")
}

model GroupBuySale {
  id            BigInt   @id @default(autoincrement())
  storeId       BigInt   @map("store_id")
  businessDate  DateTime @map("business_date") @db.Date
  platformCode  String   @map("platform_code") @db.VarChar(50)
  platformName  String   @map("platform_name") @db.VarChar(100)
  salesAmount   Decimal  @map("sales_amount") @db.Decimal(12, 2)
  customerCount Int      @map("customer_count")
  store         Store    @relation(fields: [storeId], references: [id])
  @@unique([storeId, businessDate, platformCode])
  @@map("group_buy_sales")
}

model ProductDailySale {
  id           BigInt          @id @default(autoincrement())
  storeId      BigInt          @map("store_id")
  businessDate DateTime        @map("business_date") @db.Date
  productId    BigInt          @map("product_id")
  categoryId   BigInt          @map("category_id")
  quantity     Decimal         @default(0) @db.Decimal(12, 2)
  salesAmount  Decimal         @default(0) @map("sales_amount") @db.Decimal(12, 2)
  createdAt    DateTime        @default(now()) @map("created_at")
  store        Store           @relation(fields: [storeId], references: [id])
  product      Product         @relation(fields: [productId], references: [id])
  category     ProductCategory @relation(fields: [categoryId], references: [id])
  @@unique([storeId, businessDate, productId])
  @@map("product_daily_sales")
}

model StoreDailyInput {
  id                 BigInt      @id @default(autoincrement())
  storeId            BigInt      @map("store_id")
  businessDate       DateTime    @map("business_date") @db.Date
  kitchenPower       Decimal?    @map("kitchen_power") @db.Decimal(12, 2)
  diningPower        Decimal?    @map("dining_power") @db.Decimal(12, 2)
  fullDayPower       Decimal?    @map("full_day_power") @db.Decimal(12, 2)
  airConditionPower  Decimal?    @map("air_condition_power") @db.Decimal(12, 2)
  totalPower         Decimal?    @map("total_power") @db.Decimal(12, 2)
  waterUsage         Decimal?    @map("water_usage") @db.Decimal(12, 2)
  laborHours         Decimal?    @map("labor_hours") @db.Decimal(12, 2)
  addonCustomerCount Int?        @map("addon_customer_count")
  comboCustomerCount Int?        @map("combo_customer_count")
  remark             String?     @db.Text
  status             InputStatus @default(DRAFT)
  submittedBy        BigInt?     @map("submitted_by")
  submittedAt        DateTime?   @map("submitted_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  store              Store       @relation(fields: [storeId], references: [id])
  submitter          User?       @relation(fields: [submittedBy], references: [id])
  @@unique([storeId, businessDate])
  @@map("store_daily_inputs")
}

enum InputStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

model DailyReportState {
  id           BigInt       @id @default(autoincrement())
  storeId      BigInt       @map("store_id")
  businessDate DateTime     @map("business_date") @db.Date
  status       ReportStatus @default(OPEN)
  verifiedBy   BigInt?      @map("verified_by")
  verifiedAt   DateTime?    @map("verified_at")
  lockedAt     DateTime?    @map("locked_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  store        Store        @relation(fields: [storeId], references: [id])
  @@unique([storeId, businessDate])
  @@map("daily_report_states")
}

enum ReportStatus {
  OPEN
  SUBMITTED
  VERIFIED
  LOCKED
}

model ApiSyncLog {
  id              BigInt     @id @default(autoincrement())
  storeId         BigInt     @map("store_id")
  businessDate    DateTime   @map("business_date") @db.Date
  apiType         String     @map("api_type") @db.VarChar(50)
  status          SyncStatus
  requestPayload  String?    @map("request_payload") @db.LongText
  responsePayload String?    @map("response_payload") @db.LongText
  errorMessage    String?    @map("error_message") @db.Text
  startedAt       DateTime   @default(now()) @map("started_at")
  finishedAt      DateTime?  @map("finished_at")
  store           Store      @relation(fields: [storeId], references: [id])
  @@index([storeId, businessDate, apiType])
  @@map("api_sync_logs")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?  @map("user_id")
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   BigInt   @map("entity_id")
  action     String   @db.VarChar(50)
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
