VITE_HR_FEATURES_ENABLED=true
VITE_HR_SCHEDULE_NOTIFY_ENABLED=true

# Set these template IDs from the WeChat platform if the related notice is used.
VITE_HR_SCHEDULE_TEMPLATE_ID=
VITE_HR_APPROVAL_TEMPLATE_ID=
