# Copy to .env on the server. Do not commit the real .env.
MYSQL_DATABASE=restaurant_report
MYSQL_USER=report
MYSQL_PASSWORD=replace_with_strong_password
MYSQL_ROOT_PASSWORD=replace_with_separate_strong_password
# URL-encode special characters in MYSQL_PASSWORD for DATABASE_URL.
DATABASE_URL=mysql://report:replace_with_strong_password@db:3306/restaurant_report
API_KEY=replace_with_long_random_key
# Base64-encoded 32 random bytes, generated with: openssl rand -base64 32
JWT_SECRET=replace_with_jwt_secret
WECHAT_APP_ID=replace_with_wechat_mini_program_app_id
WECHAT_APP_SECRET=replace_with_wechat_mini_program_app_secret
API_PORT=3000
SYNC_ENABLED=false
POS_CENTER_ID=replace_with_center_id
POS_APP_ID=replace_with_app_id
POS_ACCESS_ID=replace_with_access_id
POS_ADAPTER=wuuxiang
POS_BOWL_REVENUE_TYPE_ID=replace_with_pos_bowl_revenue_type_id
# Comma-separated POS settlement method names excluded only from customer counts.
POS_EXCLUDED_CUSTOMER_PAYWAYS=员工餐
POS_BRAND_NAME=米熊
POS_LUNCH_SHIFT_ID=replace_with_pos_lunch_shift_id
POS_DINNER_SHIFT_ID=replace_with_pos_dinner_shift_id
# Base64 encoding of 32 random bytes. Required to encrypt raw POS sync logs.
POS_LOG_KEY=replace_with_base64_32_byte_key
